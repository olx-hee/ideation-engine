# 백엔드 환경변수 (server/). 복사해서 .env 로 쓰거나 셸 환경에 설정.
# 아무것도 없어도 서버는 인메모리 + AI 목업으로 실행된다.

# MongoDB 연결 문자열 (넣으면 세션이 DB에 영속 저장됨)
# 예: mongodb+srv://user:pass@cluster.xxxxx.mongodb.net/ideation
MONGODB_URI=

# Claude API 키 (넣으면 /api/ai 가 실제 LLM 호출로 전환 — 준비되면)
ANTHROPIC_API_KEY=

# 서버 포트 (기본 3001)
PORT=3001

# 허용할 프론트 오리진(쉼표 구분). 없으면 dev로 보고 요청 오리진을 반영한다.
# 프로덕션에서는 반드시 지정: 예) https://ideationengine.app
CORS_ORIGIN=

# production 으로 설정하면 health 상세 정보가 숨겨진다
NODE_ENV=
