# 백엔드 환경변수 (server/). 이 파일을 `.env` 로 복사해서 쓰거나 셸 환경에 설정.
# ⭐ 아무것도 안 넣어도 서버는 인메모리 저장 + AI 목업으로 그냥 실행됩니다.
#    (실제 AI를 돌려보고 싶을 때만 OPENROUTER_API_KEY 하나 넣으면 됨)

# ── AI 호출 (핵심) ─────────────────────────────
# OpenRouter API 키. 넣으면 /api/ai 가 진짜 LLM 호출로 전환된다(없으면 목업 응답).
# https://openrouter.ai 에서 발급. 이거 하나만 있으면 대부분 동작.
OPENROUTER_API_KEY=

# ── 선택: 비용 검증 (Langfuse) ─────────────────
# 넣으면 AI 호출별 실비용이 Langfuse에 기록된다(없으면 그냥 기록 안 함).
# 무료 티어면 $0. https://cloud.langfuse.com
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# ── 선택: 시중검색 게이트 (Brave) ──────────────
# 넣으면 "이 아이디어 이미 있나?"를 실제 검색으로 확인한다(없으면 게이트 비활성).
# 무료 크레딧 있음. https://api-dashboard.search.brave.com
BRAVE_API_KEY=

# ── 선택: DB / 서버 설정 ───────────────────────
# MongoDB 연결 문자열 (넣으면 세션이 DB에 영속 저장됨. 없으면 인메모리)
# 예: mongodb+srv://user:pass@cluster.xxxxx.mongodb.net/ideation
MONGODB_URI=

# 서버 포트 (기본 3001)
PORT=3001

# 허용할 프론트 오리진(쉼표 구분). 없으면 dev로 보고 요청 오리진을 반영한다.
# 프로덕션에서는 반드시 지정: 예) https://ideationengine.app
CORS_ORIGIN=

# production 으로 설정하면 health 상세 정보가 숨겨진다
NODE_ENV=
